{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "property-marketplace",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "property-marketplace-db",
      "database_id": "390a392b-f7f9-4296-96b0-d435ffae054d"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
